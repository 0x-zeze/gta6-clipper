# gta6-clipper configuration — copy to .env and adjust
# FFmpeg path (auto-detected if empty)
FFMPEG_PATH=

# Output directory (default: current working directory)
OUTPUT_DIR=./gta6-clips

# Video quality limit for yt-dlp downloads (720, 1080, 1440, 2160)
MAX_VIDEO_HEIGHT=1080

# Subtitle translation
TRANSLATION_BATCH_SIZE=20
TARGET_LANGUAGE=Indonesian

# Chat spike detection defaults (see twitch_chat_spikes.py --help)
SPIKE_WINDOW_SECONDS=10
SPIKE_BASELINE_MINUTES=5
SPIKE_FACTOR=3.0
SPIKE_MIN_COUNT=20
SPIKE_PRE_ROLL_SECONDS=20
CLIP_MIN_DURATION=15
CLIP_MAX_DURATION=60

# Vertical cut defaults
VERTICAL_LAYOUT=gameplay
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
VERTICAL_FPS=30

# faster-whisper caption defaults
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=en

# TwitchDownloader (optional overrides)
# TWITCHDL_OAUTH_TOKEN=
# YT_DLP_PROXY=
